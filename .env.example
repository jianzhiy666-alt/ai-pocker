# ============ AI Poker Arena 环境变量 ============
# 复制为 .env 后填入你的 key。没有 key 也能跑：会用启发式机器人代替。

# 服务端口
PORT=3000

# ---- 各 provider 的 API Key（配了 key 的玩家才会真正调用大模型）----
# OpenRouter：一个 key 通吃几乎所有模型（qwen/deepseek/gemini/grok/claude/gpt...）
OPENROUTER_API_KEY=
# 阿里云百炼 Qwen（OpenAI 兼容端点）
DASHSCOPE_API_KEY=
# DeepSeek 官方
DEEPSEEK_API_KEY=
# Google Gemini（OpenAI 兼容端点）
GEMINI_API_KEY=
# xAI Grok
XAI_API_KEY=

# ---- 牌局参数 ----
# 初始筹码
STARTING_CHIPS=2000
# 每个盲注级别打几手牌后升级
HANDS_PER_LEVEL=6
# 每手牌之间的间隔（毫秒），观战节奏
HAND_DELAY_MS=900
# 行动之间的最小间隔（毫秒），太快看不清
ACTION_DELAY_MS=700
