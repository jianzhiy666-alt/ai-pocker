{
  "name": "ai-poker-arena",
  "version": "0.1.0",
  "private": true,
  "description": "AI Poker Arena — Texas Hold'em tournament where each seat is an LLM-backed AI player (Qwen / DeepSeek / Gemini / Grok via OpenRouter or direct providers)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "play": "tsx scripts/play.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "pokersolver": "^2.1.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
